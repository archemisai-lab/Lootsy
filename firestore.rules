rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'archemis.ai@gmail.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      // Authenticated users can read profiles for community / leaderboard
      allow read: if isSignedIn();
      // On creation, cannot elevate role or set verification unless admin
      allow create: if (isOwner(userId) || isAdmin()) && (
        (!('role' in incoming()) || incoming().role == 'user' || isAdmin()) &&
        (!('isVerified' in incoming()) || incoming().isVerified == false || isAdmin())
      );
      // On update, users can update profile, photoURL, and XP gains, or full admin control
      allow update: if isSignedIn() && (
        (isOwner(userId) && !incoming().diff(existing()).affectedKeys().hasAny(['role', 'isVerified'])) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['xp', 'updatedAt']) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['photoURL', 'updatedAt']) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Admins privileged collection
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && request.auth.token.email == 'archemis.ai@gmail.com');
    }

    // Public News Radar
    match /news/{newsId} {
      // Editorial news is publicly readable
      allow read: if true;
      allow write: if isAdmin();
    }

    // Saved news items
    match /savedNews/{savedId} {
      allow read: if isSignedIn() && (existing().userUid == request.auth.uid || existing().uid == request.auth.uid);
      allow create: if isSignedIn() && (incoming().userUid == request.auth.uid || incoming().uid == request.auth.uid);
      allow delete: if isSignedIn() && (existing().userUid == request.auth.uid || existing().uid == request.auth.uid);
    }

    // Private squads / groups
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        incoming().ownerUid == request.auth.uid ||
        incoming().uid == request.auth.uid ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        existing().ownerUid == request.auth.uid ||
        incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'memberCount', 'updatedAt']) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());

      // Group members subcollection
      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && (
          incoming().uid == request.auth.uid ||
          incoming().userUid == request.auth.uid ||
          get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid ||
          isAdmin()
        );
        allow update, delete: if isSignedIn() && (
          existing().uid == request.auth.uid ||
          existing().userUid == request.auth.uid ||
          get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid ||
          isAdmin()
        );
      }

      // Group invite codes
      match /invites/{inviteId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && (
          incoming().createdBy == request.auth.uid ||
          incoming().createdByUid == request.auth.uid ||
          get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid ||
          isAdmin()
        );
        allow update, delete: if isSignedIn() && (
          existing().createdBy == request.auth.uid ||
          existing().createdByUid == request.auth.uid ||
          get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // Challenges
    match /challenges/{challengeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        incoming().createdBy == request.auth.uid ||
        incoming().createdByUid == request.auth.uid ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        existing().createdBy == request.auth.uid ||
        existing().createdByUid == request.auth.uid ||
        incoming().diff(existing()).affectedKeys().hasOnly(['participantUids', 'updatedAt']) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        existing().createdBy == request.auth.uid ||
        existing().createdByUid == request.auth.uid ||
        isAdmin()
      );

      // Challenge participants & proof validation
      match /participants/{participantId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && (
          incoming().uid == request.auth.uid ||
          incoming().userUid == request.auth.uid ||
          get(/databases/$(database)/documents/challenges/$(challengeId)).data.createdBy == request.auth.uid ||
          get(/databases/$(database)/documents/challenges/$(challengeId)).data.createdByUid == request.auth.uid ||
          isAdmin()
        );
        // Anti-cheating: A participant cannot approve their own proof!
        allow update: if isSignedIn() && (
          // Participant can update their own status/proof without self-validating
          (
            (existing().uid == request.auth.uid || existing().userUid == request.auth.uid) &&
            !incoming().diff(existing()).affectedKeys().hasAny(['verifiedBy', 'verifiedAt', 'xpAwarded'])
          ) ||
          // Creator of challenge or admin can validate / reject
          (
            get(/databases/$(database)/documents/challenges/$(challengeId)).data.createdBy == request.auth.uid ||
            get(/databases/$(database)/documents/challenges/$(challengeId)).data.createdByUid == request.auth.uid ||
            isAdmin()
          ) ||
          isAdmin()
        );
        allow delete: if isSignedIn() && (
          existing().uid == request.auth.uid ||
          existing().userUid == request.auth.uid ||
          get(/databases/$(database)/documents/challenges/$(challengeId)).data.createdBy == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // In-app notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (existing().userUid == request.auth.uid || existing().uid == request.auth.uid);
      allow update: if isSignedIn() && (existing().userUid == request.auth.uid || existing().uid == request.auth.uid);
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && (existing().userUid == request.auth.uid || existing().uid == request.auth.uid || isAdmin());
    }

    // XP Ledger
    match /xpLedger/{ledgerId} {
      allow read: if isSignedIn() && (existing().userUid == request.auth.uid || existing().uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Content reports & Moderation
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && (incoming().reportedByUid == request.auth.uid || incoming().reportedBy == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Audit logs
    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit log!
    }

    // System Settings & Feature Flags
    match /systemSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
